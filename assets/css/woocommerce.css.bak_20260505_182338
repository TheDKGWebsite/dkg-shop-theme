/* DKG clean WooCommerce layout */

/* Product grid */
.woocommerce ul.products {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 2rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.woocommerce ul.products li.product {
  width: auto !important;
  margin: 0 !important;
  float: none !important;
  padding: 14px !important;
  border-radius: 22px;
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.12);
  overflow: hidden;
}

.woocommerce ul.products li.product a img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 16px;
}

.woocommerce ul.products li.product .woocommerce-loop-product__title {
  color: #fff;
}

.woocommerce ul.products li.product .price {
  color: rgba(255,255,255,0.85);
}

.woocommerce ul.products li.product .button {
  display: inline-block;
  margin-top: 0.75rem;
}

/* Single product */
.single-product div.product {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
}

/* Full-page dynamic shop background */
body {
  background-color: #000;
}

.dkg-real-shop-bg {
  position: fixed !important;
  inset: 0 !important;
  z-index: 0 !important;
  background-size: cover !important;
  background-position: center !important;
  background-repeat: no-repeat !important;
  opacity: 0.65 !important;
  pointer-events: none !important;
}

.dkg-real-shop-bg-overlay {
  position: fixed !important;
  inset: 0 !important;
  z-index: 1 !important;
  background: rgba(0,0,0,0.48) !important;
  pointer-events: none !important;
}

/* Keep actual page above background */
.site-header,
.dkg-shop-main,
.site-footer {
  position: relative !important;
  z-index: 2 !important;
}

/* Shop content wrapper */
.dkg-shop-main {
  width: 100%;
  max-width: 100%;
  margin: 0 auto;
  padding: 70px 20px 110px;
  color: #fff;
}

.dkg-shop-plate {
  width: min(1180px, calc(100vw - 80px));
  margin: 0 auto 70px;
  padding: 34px;
  border: 2px solid rgba(255,255,255,0.22);
  border-radius: 34px;
  background: rgba(20,20,20,0.72);
  box-shadow: 0 24px 80px rgba(0,0,0,0.45);
  backdrop-filter: blur(2px);
}

.dkg-shop-plate h1,
.dkg-shop-plate h2 {
  margin: 0 0 28px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #fff;
}

.dkg-featured-collection {
  border-color: rgba(255,255,255,0.38);
}

.dkg-more-products h2 {
  margin-top: 4px;
}

/* Disable old pseudo backgrounds if any browser cached old rules */
.dkg-shop-main::before,
.dkg-shop-main::after {
  content: none !important;
  display: none !important;
}

/* Mobile */
@media (max-width: 900px) {
  .woocommerce ul.products {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .single-product div.product {
    grid-template-columns: 1fr;
  }

  .dkg-shop-plate {
    width: min(100%, calc(100vw - 36px));
    padding: 22px;
    border-radius: 26px;
  }

  .dkg-shop-main {
    padding: 38px 0 80px;
  }
}

/* === DKG CART BACKGROUND START === */

/*
  Cart-only background.
  Put your custom image here:
  assets/images/cart-bg.png

  This overrides the global bricks.png background only on:
  /cart/
*/

body.woocommerce-cart {
  background-color: #000 !important;
  background-image: url("../images/cart-bg.png") !important;
  background-size: cover !important;
  background-position: center center !important;
  background-repeat: no-repeat !important;
  background-attachment: fixed !important;
}

/* Keep the cart page content readable over the background */
body.woocommerce-cart .site-main {
  min-height: calc(100vh - 140px);
  color: #fff;
  position: relative;
  z-index: 2;
}

body.woocommerce-cart .site-main .container {
  background: rgba(20, 20, 20, 0.72);
  border: 2px solid rgba(255, 255, 255, 0.22);
  border-radius: 34px;
  box-shadow: 0 24px 80px rgba(0, 0, 0, 0.45);
  padding: 34px;
  margin-top: 70px;
  margin-bottom: 70px;
  backdrop-filter: blur(2px);
}

body.woocommerce-cart .woocommerce {
  color: #fff;
}

body.woocommerce-cart table.shop_table,
body.woocommerce-cart .cart_totals,
body.woocommerce-cart .woocommerce-cart-form {
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  border-radius: 18px;
}

body.woocommerce-cart table.shop_table {
  border-color: rgba(255, 255, 255, 0.22);
}

body.woocommerce-cart table.shop_table th,
body.woocommerce-cart table.shop_table td {
  color: #fff;
  border-color: rgba(255, 255, 255, 0.18);
}

body.woocommerce-cart a,
body.woocommerce-cart .woocommerce a {
  color: #fff;
}

body.woocommerce-cart .button,
body.woocommerce-cart button.button,
body.woocommerce-cart input.button,
body.woocommerce-cart a.button {
  background: #fff !important;
  color: #000 !important;
  border-radius: 999px !important;
  font-weight: 700 !important;
  border: none !important;
}

body.woocommerce-cart .button:hover,
body.woocommerce-cart button.button:hover,
body.woocommerce-cart input.button:hover,
body.woocommerce-cart a.button:hover {
  background: #dcdcdc !important;
  color: #000 !important;
}

/* If any old overlay appears on the cart page, neutralize it */
body.woocommerce-cart .page-overlay {
  background: transparent !important;
}

@media (max-width: 700px) {
  body.woocommerce-cart .site-main .container {
    margin-top: 30px;
    margin-bottom: 40px;
    padding: 20px;
    border-radius: 24px;
  }
}

/* === DKG CART BACKGROUND END === */

/* === DKG SINGLE PRODUCT PLATE IMAGE BG START === */

/*
  Single product page:
  keep the rounded plate shape, but use your own opaque image background.

  Put your image here:
  assets/images/product-plate-bg.png
*/

body.single-product .dkg-shop-plate {
  position: relative !important;
  overflow: hidden !important;
  border-radius: 34px !important;

  /* replace the transparent gray plate with your own image */
  background: url("../images/product-plate-bg.png") center center / cover no-repeat !important;

  /* turn off the glassy look */
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
}

/* keep content above the background */
body.single-product .dkg-shop-plate > * {
  position: relative;
  z-index: 1;
}

/* optional: make inner WooCommerce boxes transparent so the plate image shows through better */
body.single-product .dkg-shop-plate .woocommerce-tabs,
body.single-product .dkg-shop-plate .related,
body.single-product .dkg-shop-plate .upsells {
  background: transparent !important;
}

/* keep text readable */
body.single-product .dkg-shop-plate,
body.single-product .dkg-shop-plate .summary,
body.single-product .dkg-shop-plate .summary p,
body.single-product .dkg-shop-plate .summary h1,
body.single-product .dkg-shop-plate .summary h2,
body.single-product .dkg-shop-plate .summary h3,
body.single-product .dkg-shop-plate .price,
body.single-product .dkg-shop-plate .woocommerce-product-details__short-description {
  color: #fff !important;
}

/* buttons still readable */
body.single-product .dkg-shop-plate .button,
body.single-product .dkg-shop-plate button.button,
body.single-product .dkg-shop-plate input.button,
body.single-product .dkg-shop-plate a.button {
  position: relative;
  z-index: 1;
}

/* === DKG SINGLE PRODUCT PLATE IMAGE BG END === */

/* === DKG SINGLE PRODUCT BIG IMAGE FORCE START === */
/* Loaded in woocommerce.css because it comes after style.css/main.css. */
body.single-product main.dkg-shop-main {
  padding-top: 45px !important;
}

body.single-product .dkg-shop-plate {
  width: min(1500px, calc(100vw - 60px)) !important;
  max-width: 1500px !important;
  padding: 38px !important;
}

body.single-product .dkg-shop-plate .woocommerce div.product,
body.single-product .dkg-shop-plate div.product {
  display: grid !important;
  grid-template-columns: minmax(360px, 1fr) minmax(360px, 1fr) !important;
  gap: 48px !important;
  align-items: start !important;
  width: 100% !important;
  max-width: none !important;
  margin: 0 !important;
}

body.single-product .dkg-shop-plate div.product div.images,
body.single-product .dkg-shop-plate .woocommerce-product-gallery {
  width: 100% !important;
  max-width: none !important;
  float: none !important;
  margin: 0 !important;
}

body.single-product .dkg-shop-plate div.product div.summary,
body.single-product .dkg-shop-plate .summary.entry-summary {
  width: 100% !important;
  max-width: none !important;
  float: none !important;
  margin: 0 !important;
}

body.single-product .dkg-shop-plate div.product div.images img,
body.single-product .dkg-shop-plate .woocommerce-product-gallery img {
  width: 100% !important;
  height: auto !important;
  display: block !important;
}

@media (max-width: 900px) {
  body.single-product .dkg-shop-plate {
    width: min(100%, calc(100vw - 28px)) !important;
    padding: 22px !important;
  }

  body.single-product .dkg-shop-plate .woocommerce div.product,
  body.single-product .dkg-shop-plate div.product {
    display: block !important;
  }

  body.single-product .dkg-shop-plate div.product div.images,
  body.single-product .dkg-shop-plate .woocommerce-product-gallery,
  body.single-product .dkg-shop-plate div.product div.summary,
  body.single-product .dkg-shop-plate .summary.entry-summary {
    width: 100% !important;
    max-width: none !important;
  }
}
/* === DKG SINGLE PRODUCT BIG IMAGE FORCE END === */

/* === DKG PRODUCT SIZE DROPDOWN FIX START === */

.single-product select,
.single-product .variations select,
.single-product table.variations select,
.woocommerce div.product form.cart .variations select {
  background: #000 !important;
  color: #fff !important;
  border: 1px solid rgba(255,255,255,0.45) !important;
  border-radius: 8px !important;
  padding: 8px 12px !important;
}

.single-product select option,
.single-product .variations select option,
.woocommerce div.product form.cart .variations select option {
  background: #000 !important;
  color: #fff !important;
}

/* Optional: make the label readable too */
.single-product .variations label,
.woocommerce div.product form.cart .variations label {
  color: #fff !important;
}

/* === DKG PRODUCT SIZE DROPDOWN FIX END === */

/* === DKG CART CHECKOUT ORDER STYLE START === */

.woocommerce-cart .wc-proceed-to-checkout {
  display: flex !important;
  flex-direction: column !important;
  gap: 14px !important;
}

.woocommerce-cart .wc-proceed-to-checkout a.checkout-button {
  order: -20 !important;
  margin: 0 !important;
  background: #fff !important;
  color: #000 !important;
  border: 1px solid rgba(0,0,0,0.6) !important;
  border-radius: 0 !important;
  font-size: 1.2rem !important;
  font-weight: 400 !important;
  padding: 16px 20px !important;
  text-align: center !important;
}

.woocommerce-cart .dkg-cart-or-separator {
  order: -10 !important;
  color: #000 !important;
  font-size: 14px !important;
  line-height: 1 !important;
  text-align: center !important;
  margin: 4px 0 !important;
  width: 100% !important;
}

.woocommerce-cart .wc-proceed-to-checkout p,
.woocommerce-cart .wc-proceed-to-checkout span {
  text-align: center !important;
}

.woocommerce-cart .wc-proceed-to-checkout iframe,
.woocommerce-cart .wc-proceed-to-checkout button,
.woocommerce-cart .wc-proceed-to-checkout .button,
.woocommerce-cart .wc-proceed-to-checkout [class*="payment"],
.woocommerce-cart .wc-proceed-to-checkout [class*="express"] {
  max-width: 100% !important;
}

/* === DKG CART CHECKOUT ORDER STYLE END === */
