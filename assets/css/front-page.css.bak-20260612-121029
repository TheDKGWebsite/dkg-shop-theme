/* === DKG CENTERED FLOATING COLLECTION LABEL START === */

/*
  Homepage collection labels:
  - Center the collection title horizontally.
  - Put the title's midpoint on the top edge of the plate.
  - Half of the title hangs above the plate.
  - Applies to all current/future homepage collection boxes using .collection-label.
*/

.collections-stack {
  gap: 36px !important;
}

.collection-link {
  overflow: visible !important;
}

.collection-box {
  overflow: visible !important;
  position: relative !important;
}

.collection-bg {
  overflow: hidden !important;
}

.collection-label {
  position: absolute !important;

  /* .collection-box has 24px top padding, so -24px moves the label
     anchor from the inner content area up to the actual plate top edge. */
  top: -24px !important;
  left: 50% !important;
  right: auto !important;
  bottom: auto !important;

  transform: translate(-50%, -50%) !important;

  z-index: 50 !important;
  margin: 0 !important;

  width: max-content !important;
  max-width: calc(100% - 48px) !important;

  text-align: center !important;
  white-space: nowrap !important;
  pointer-events: none !important;
}

/* === DKG CENTERED FLOATING COLLECTION LABEL END === */

/* === DKG HOMEPAGE FIXED STAGE V2 START === */

/*
  Homepage fixed-stage V2.

  What this does:
  - Header background stretches full-width again.
  - Header contents stay on the same stage system as the plates.
  - Homepage collection plates stay as a fixed 1400px x 260px design stage.
  - A JS-set CSS variable counteracts browser zoom as much as the browser allows.

  Important:
  Browser zoom cannot be truly disabled by CSS. This patch counter-scales the
  homepage stage using devicePixelRatio changes, which works much better for
  Ctrl+/Ctrl- style testing in Chrome.
*/

@media (min-width: 901px) {

  body.home,
  body.front-page,
  body.page-template-front-page {
    --dkg-home-stage-width: 1400px;
    --dkg-home-stage-scale: min(1, calc((100vw - 48px) / 1400));
    --dkg-browser-zoom-counter: 1;
    overflow-x: hidden !important;
  }

  /*
    HEADER FULL-BLEED FIX:
    The header itself should stretch edge-to-edge.
    Do NOT scale the header background/container.
  */
  body.home .site-header,
  body.front-page .site-header,
  body.page-template-front-page .site-header {
    width: 100vw !important;
    max-width: none !important;
    min-width: 100vw !important;

    margin-left: calc(50% - 50vw) !important;
    margin-right: 0 !important;

    transform: none !important;
    transform-origin: top center !important;

    box-sizing: border-box !important;
  }

  /*
    Header content gets counter-scaled, not the full-width header background.
    These selectors cover your current header structure and common wrappers.
  */
  body.home .site-header > *,
  body.front-page .site-header > *,
  body.page-template-front-page .site-header > * {
    transform: scale(var(--dkg-browser-zoom-counter)) !important;
    transform-origin: top center !important;
  }

  /*
    If the header has nav/logo elements without a wrapper, keep their layout
    from stretching strangely.
  */
  body.home .site-header .site-logo,
  body.home .site-header .nav,
  body.home .site-header .nav a,
  body.home .site-header .nav-social,
  body.front-page .site-header .site-logo,
  body.front-page .site-header .nav,
  body.front-page .site-header .nav a,
  body.front-page .site-header .nav-social,
  body.page-template-front-page .site-header .site-logo,
  body.page-template-front-page .site-header .nav,
  body.page-template-front-page .site-header .nav a,
  body.page-template-front-page .site-header .nav-social {
    box-sizing: border-box !important;
  }

  /*
    COLLECTION STAGE:
    This is the fixed plate area. It scales down only if viewport width
    physically cannot fit it, and also counter-scales against browser zoom.
  */
  body.home .collections-section,
  body.front-page .collections-section,
  body.page-template-front-page .collections-section {
    width: var(--dkg-home-stage-width) !important;
    max-width: none !important;
    min-width: var(--dkg-home-stage-width) !important;

    margin-left: auto !important;
    margin-right: auto !important;

    padding-left: 0 !important;
    padding-right: 0 !important;

    transform: scale(calc(var(--dkg-home-stage-scale) * var(--dkg-browser-zoom-counter))) !important;
    transform-origin: top center !important;

    box-sizing: border-box !important;
  }

  body.home .collections-stack,
  body.front-page .collections-stack,
  body.page-template-front-page .collections-stack {
    width: var(--dkg-home-stage-width) !important;
    max-width: none !important;
    min-width: var(--dkg-home-stage-width) !important;

    align-items: center !important;
    gap: 36px !important;

    box-sizing: border-box !important;
  }

  body.home .collection-link,
  body.front-page .collection-link,
  body.page-template-front-page .collection-link {
    width: var(--dkg-home-stage-width) !important;
    max-width: none !important;
    min-width: var(--dkg-home-stage-width) !important;

    margin-left: auto !important;
    margin-right: auto !important;

    overflow: visible !important;
    box-sizing: border-box !important;
  }

  body.home .collection-box,
  body.front-page .collection-box,
  body.page-template-front-page .collection-box {
    width: var(--dkg-home-stage-width) !important;
    max-width: none !important;
    min-width: var(--dkg-home-stage-width) !important;

    height: 260px !important;
    min-height: 260px !important;
    max-height: 260px !important;

    padding: 24px 24px 4px !important;

    overflow: visible !important;
    position: relative !important;
    box-sizing: border-box !important;
  }

  body.home .collection-bg,
  body.front-page .collection-bg,
  body.page-template-front-page .collection-bg {
    overflow: hidden !important;
  }

  body.home .product-track,
  body.front-page .product-track,
  body.page-template-front-page .product-track {
    width: 100% !important;
    height: 100% !important;
    gap: 14px !important;
    justify-content: flex-start !important;
  }

  body.home .product-card,
  body.front-page .product-card,
  body.page-template-front-page .product-card {
    flex: 0 0 calc((100% - 56px) / 5) !important;
    width: calc((100% - 56px) / 5) !important;
    min-width: calc((100% - 56px) / 5) !important;
    height: 100% !important;
  }
}

@media (max-width: 900px) {
  body.home .site-header,
  body.front-page .site-header,
  body.page-template-front-page .site-header,
  body.home .site-header > *,
  body.front-page .site-header > *,
  body.page-template-front-page .site-header > *,
  body.home .collections-section,
  body.front-page .collections-section,
  body.page-template-front-page .collections-section {
    transform: none !important;
    min-width: 0 !important;
  }
}

/* === DKG HOMEPAGE FIXED STAGE V2 END === */

/* === DKG HOMEPAGE PRODUCT IMAGE QUALITY FIX START === */

/*
  Homepage collection plate product images:
  - Keep higher-quality image files from front-page.php.
  - Fill each product card so there are no left/right gaps.
  - Center the crop so the image does not feel pushed down.
*/

.collection-box .product-card {
  display: block !important;
  overflow: hidden !important;
}

.collection-box .product-image {
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
  object-position: center center !important;
  display: block !important;
  image-rendering: auto !important;
}

/* === DKG HOMEPAGE PRODUCT IMAGE QUALITY FIX END === */

/* === DKG MOBILE MAIN HOMEPAGE COLLECTION PLATES START === */

/*
  DKG mobile homepage collection plates.

  Step 2:
  - Phone users stay on normal homepage.
  - Plates stay vertically stacked.
  - Each plate is a horizontal 1x3 row on mobile.
  - Exactly 3 product slots are visible at a time.
  - If a collection has more than 3 products, horizontal scrolling starts on mobile.
  - Product images fit inside their frames instead of being cropped.
  - Header layout is intentionally not changed here.
*/

@media screen and (max-width: 767px) {

  body:not(.page-mobile-shop):not(.page-template-page-mobile-shop).home,
  body:not(.page-mobile-shop):not(.page-template-page-mobile-shop).front-page,
  body:not(.page-mobile-shop):not(.page-template-page-mobile-shop).page-template-front-page {
    overflow-x: hidden !important;
  }

  body:not(.page-mobile-shop):not(.page-template-page-mobile-shop) .collections-stack {
    width: min(calc(100vw - 14px), 560px) !important;
    max-width: min(calc(100vw - 14px), 560px) !important;
    margin-left: auto !important;
    margin-right: auto !important;

    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;

    gap: clamp(20px, 5vw, 32px) !important;
    padding-left: 0 !important;
    padding-right: 0 !important;

    box-sizing: border-box !important;
  }

  body:not(.page-mobile-shop):not(.page-template-page-mobile-shop) .collection-link {
    width: 100% !important;
    max-width: 100% !important;
    display: block !important;
    overflow: visible !important;
    box-sizing: border-box !important;
  }

  body:not(.page-mobile-shop):not(.page-template-page-mobile-shop) .collection-box {
    width: 100% !important;
    max-width: 100% !important;

    min-height: clamp(132px, 38vw, 184px) !important;
    height: clamp(132px, 38vw, 184px) !important;

    position: relative !important;
    overflow: hidden !important;
    box-sizing: border-box !important;

    transform: none !important;
  }

  body:not(.page-mobile-shop):not(.page-template-page-mobile-shop) .collection-bg {
    width: 100% !important;
    height: 100% !important;
    min-height: inherit !important;
    overflow: hidden !important;
    border-radius: clamp(16px, 5vw, 28px) !important;
    box-sizing: border-box !important;
  }

  body:not(.page-mobile-shop):not(.page-template-page-mobile-shop) .collection-box.dkg-mobile-main-plate-prepared {
    --dkg-mobile-visible-count: 3;
    --dkg-mobile-plate-gap: clamp(5px, 1.5vw, 8px);
    --dkg-mobile-plate-pad-x: clamp(8px, 2.4vw, 12px);
    --dkg-mobile-plate-pad-y: clamp(10px, 2.8vw, 14px);
    --dkg-mobile-product-slot-width: calc(
      (100% - (var(--dkg-mobile-plate-pad-x) * 2) - (var(--dkg-mobile-plate-gap) * 2)) / 3
    );
  }

  /*
    Product row/track.
    This is the important part:
    - flex row
    - each product slot is exactly 1/3 of the visible interior width
    - if there are 4+ products, the track scrolls horizontally
  */
  body:not(.page-mobile-shop):not(.page-template-page-mobile-shop) .collection-box.dkg-mobile-main-plate-prepared ul.products,
  body:not(.page-mobile-shop):not(.page-template-page-mobile-shop) .collection-box.dkg-mobile-main-plate-prepared .products,
