* {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      min-height: 100%;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      color: #ffffff;
      background-color: #111;
      background-image: url("../images/bricks.png");
      background-repeat: repeat;
      background-position: top left;
      background-size: 2560px 2560px;
      background-attachment: scroll;
    }

    .page-overlay {
      min-height: 100vh;
      background: rgba(0, 0, 0, 0.45);
    }

    .site-header {
      width: 100%;
      padding: 24px 40px;
      background: rgba(0, 0, 0, 0.35);
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      position: sticky;
      top: 0;
      z-index: 50;
      backdrop-filter: blur(4px);
    }

    .header-inner {
      max-width: 1400px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
    }

    .logo {
      font-size: 1.8rem;
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .nav {
      display: flex;
      gap: 20px;
      flex-wrap: wrap;
    }

    .nav a {
      color: #fff;
      text-decoration: none;
      opacity: 0.9;
    }

    .nav a:hover {
      opacity: 0.6;
    }

    .hero {
      text-align: center;
      padding: 70px 20px 40px;
    }

    .hero h1 {
      font-size: clamp(2.5rem, 5vw, 5rem);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .hero p {
      max-width: 700px;
      margin: 15px auto 0;
      color: rgba(255,255,255,0.85);
      line-height: 1.6;
    }

    .collections-section {
      max-width: 1400px;
      margin: 0 auto;
      padding: 40px 20px 100px;
    }

    .collections-stack {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 20px;
    }

    .collection-box {
      position: relative;
      width: 100%;
      height: 260px;
      border: 3px solid;
      border-radius: 30px;
      padding: 24px 24px 4px;
      background: transparent;
      overflow: visible;
      display: flex;
      align-items: stretch;
    }

    .collection-bg {
      position: absolute;
      inset: 0;
      border-radius: inherit;
      overflow: hidden;
      z-index: 0;
}

    .collection-bg img {
      width: 100%;
      height: 100%;
      object-fit: fill;
      display: block;
      filter: brightness(0.75);
    }

    .collection-content {
      position: relative;
      z-index: 1;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: stretch;
    }

    .collection-link {
      display: block;
      width: min(1400px, 95%);
      color: inherit;
      text-decoration: none;
    }

    .collection-link:hover,
    .collection-link:focus,
    .collection-link:active,
    .collection-link:visited {
      color: inherit;
      text-decoration: none;
    }

    .collection-link .collection-box {
      width: 100%;
      cursor: pointer;
      transition: transform 0.18s ease, background 0.18s ease;
    }

    .collection-link:hover .collection-box,
    .collection-link:focus .collection-box {
      transform: translateY(-2px);
      background: rgba(0,0,0,0.55);
    }

	.collection-label {
      position: absolute;
      top: -14px;
      left: 20px;
      padding: 8px 16px;
      border: 3px solid currentColor;
      border-radius: 999px;
      background: #000;
      padding: 6px 14px;
      font-weight: bold;
      text-transform: uppercase;
      font-size: 0.9rem;
      z-index: 4;
    }

    .carousel-shell {
      position: relative;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: stretch;
    }

    .product-viewport {
      width: 100%;
      height: 100%;
      overflow: hidden;
      position: relative;
      border-radius: 22px;
    }

    .product-track {
      display: flex;
      gap: 14px;
      transition: transform 0.5s ease;
      will-change: transform;
      align-items: stretch;
      height: 100%;
      justify-content: flex-start;
    }

    \1
      text-decoration: none;
      color: inherit;
      flex: 0 0 calc((100% - 56px) / 5);
      height: 100%;
      border-radius: 22px;
      overflow: hidden;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.12);display: flex;
      flex-direction: column;
    }

    .product-titlebar {
      flex: 0 0 auto;
      padding: 8px 10px 6px;
      background: rgba(0,0,0,0.45);
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .product-title {
      color: #ffffff;
      font-size: 0.88rem;
      line-height: 1.1;
      font-weight: 700;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .product-meta {
      position: relative;
      flex: 1 1 auto;
      min-height: 0;
    }

    .product-image {
      width: 100%;
      height: 100%;
      object-fit: fill;
      display: block;
      background: rgba(255,255,255,0.06);
    }

    .product-stock {
      position: absolute;
      right: 10px;
      bottom: 10px;
      max-width: calc(100% - 20px);
      padding: 4px 8px;
      border-radius: 10px;
      background: rgba(0,0,0,0.55);
      color: rgba(255,255,255,0.9);
      font-size: 0.78rem;
      line-height: 1.1;
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .red { border-color: #ff4d4d; color: #ff4d4d; }
    .blue { border-color: #4da6ff; color: #4da6ff; }
    .green { border-color: #49d17d; color: #49d17d; }
    .yellow { border-color: #ffd84d; color: #ffd84d; }

    .site-footer {
      text-align: center;
      padding: 20px;
      background: rgba(0,0,0,0.35);
      border-top: 1px solid rgba(255,255,255,0.1);
      font-size: 0.9rem;
      opacity: 0.8;
    }

    @media (max-width: 980px) {
      .product-card {
        flex-basis: 200px;
        max-width: 200px;
      }
    }

    @media (max-width: 640px) {
      .site-header {
        padding: 18px 20px;
      }

      .header-inner {
        flex-direction: column;
        align-items: flex-start;
      }

      .collection-box {
        padding: 74px 18px 20px;
        border-radius: 24px;
      }

      
      .product-card {
        flex-basis: 80%;
        max-width: 80%;
      }

      .product-image {
        height: 150px;
      }    }

.product-card:hover,
.product-card:focus {
  transform: translateY(-2px);
  border-color: rgba(255,255,255,0.22);
}

.product-card--empty {
  justify-content: center;
}

.product-card--empty .product-meta {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.product-track.count-1 .product-card {
  flex-basis: 280px;
  max-width: 280px;
}

.product-track.count-2 .product-card {
  flex-basis: 240px;
  max-width: 240px;
}

.collection-label {
  text-decoration: none;
  color: inherit;
  display: inline-block;
}
