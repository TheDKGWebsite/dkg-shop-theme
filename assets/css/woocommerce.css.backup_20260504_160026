/* DKG clean WooCommerce layout */

/* Product grid */
.woocommerce ul.products {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 2rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.woocommerce ul.products li.product {
  width: auto !important;
  margin: 0 !important;
  float: none !important;
  padding: 14px !important;
  border-radius: 22px;
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.12);
  overflow: hidden;
}

.woocommerce ul.products li.product a img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 16px;
}

.woocommerce ul.products li.product .woocommerce-loop-product__title {
  color: #fff;
}

.woocommerce ul.products li.product .price {
  color: rgba(255,255,255,0.85);
}

.woocommerce ul.products li.product .button {
  display: inline-block;
  margin-top: 0.75rem;
}

/* Single product */
.single-product div.product {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
}

/* Full-page dynamic shop background */
body {
  background-color: #000;
}

.dkg-real-shop-bg {
  position: fixed !important;
  inset: 0 !important;
  z-index: 0 !important;
  background-size: cover !important;
  background-position: center !important;
  background-repeat: no-repeat !important;
  opacity: 0.65 !important;
  pointer-events: none !important;
}

.dkg-real-shop-bg-overlay {
  position: fixed !important;
  inset: 0 !important;
  z-index: 1 !important;
  background: rgba(0,0,0,0.48) !important;
  pointer-events: none !important;
}

/* Keep actual page above background */
.site-header,
.dkg-shop-main,
.site-footer {
  position: relative !important;
  z-index: 2 !important;
}

/* Shop content wrapper */
.dkg-shop-main {
  width: 100%;
  max-width: 100%;
  margin: 0 auto;
  padding: 70px 20px 110px;
  color: #fff;
}

.dkg-shop-plate {
  width: min(1180px, calc(100vw - 80px));
  margin: 0 auto 70px;
  padding: 34px;
  border: 2px solid rgba(255,255,255,0.22);
  border-radius: 34px;
  background: rgba(20,20,20,0.72);
  box-shadow: 0 24px 80px rgba(0,0,0,0.45);
  backdrop-filter: blur(2px);
}

.dkg-shop-plate h1,
.dkg-shop-plate h2 {
  margin: 0 0 28px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #fff;
}

.dkg-featured-collection {
  border-color: rgba(255,255,255,0.38);
}

.dkg-more-products h2 {
  margin-top: 4px;
}

/* Disable old pseudo backgrounds if any browser cached old rules */
.dkg-shop-main::before,
.dkg-shop-main::after {
  content: none !important;
  display: none !important;
}

/* Mobile */
@media (max-width: 900px) {
  .woocommerce ul.products {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .single-product div.product {
    grid-template-columns: 1fr;
  }

  .dkg-shop-plate {
    width: min(100%, calc(100vw - 36px));
    padding: 22px;
    border-radius: 26px;
  }

  .dkg-shop-main {
    padding: 38px 0 80px;
  }
}

/* === DKG CART BACKGROUND START === */

/*
  Cart-only background.
  Put your custom image here:
  assets/images/cart-bg.png

  This overrides the global bricks.png background only on:
  /cart/
*/

body.woocommerce-cart {
  background-color: #000 !important;
  background-image: url("../images/cart-bg.png") !important;
  background-size: cover !important;
  background-position: center center !important;
  background-repeat: no-repeat !important;
  background-attachment: fixed !important;
}

/* Keep the cart page content readable over the background */
body.woocommerce-cart .site-main {
  min-height: calc(100vh - 140px);
  color: #fff;
  position: relative;
  z-index: 2;
}

body.woocommerce-cart .site-main .container {
  background: rgba(20, 20, 20, 0.72);
  border: 2px solid rgba(255, 255, 255, 0.22);
  border-radius: 34px;
  box-shadow: 0 24px 80px rgba(0, 0, 0, 0.45);
  padding: 34px;
  margin-top: 70px;
  margin-bottom: 70px;
  backdrop-filter: blur(2px);
}

body.woocommerce-cart .woocommerce {
  color: #fff;
}

body.woocommerce-cart table.shop_table,
body.woocommerce-cart .cart_totals,
body.woocommerce-cart .woocommerce-cart-form {
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  border-radius: 18px;
}

body.woocommerce-cart table.shop_table {
  border-color: rgba(255, 255, 255, 0.22);
}

body.woocommerce-cart table.shop_table th,
body.woocommerce-cart table.shop_table td {
  color: #fff;
  border-color: rgba(255, 255, 255, 0.18);
}

body.woocommerce-cart a,
body.woocommerce-cart .woocommerce a {
  color: #fff;
}

body.woocommerce-cart .button,
body.woocommerce-cart button.button,
body.woocommerce-cart input.button,
body.woocommerce-cart a.button {
  background: #fff !important;
  color: #000 !important;
  border-radius: 999px !important;
  font-weight: 700 !important;
  border: none !important;
}

body.woocommerce-cart .button:hover,
body.woocommerce-cart button.button:hover,
body.woocommerce-cart input.button:hover,
body.woocommerce-cart a.button:hover {
  background: #dcdcdc !important;
  color: #000 !important;
}

/* If any old overlay appears on the cart page, neutralize it */
body.woocommerce-cart .page-overlay {
  background: transparent !important;
}

@media (max-width: 700px) {
  body.woocommerce-cart .site-main .container {
    margin-top: 30px;
    margin-bottom: 40px;
    padding: 20px;
    border-radius: 24px;
  }
}

/* === DKG CART BACKGROUND END === */
