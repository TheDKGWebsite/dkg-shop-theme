* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html,
body {
  min-height: 100%;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  color: #ffffff;
  background-color: #111;
  background-image: url("../images/xbricks.png");
  background-repeat: repeat;
  background-position: top left;
  background-size: 2560px 2560px;
  background-attachment: scroll;
}

.page-overlay {
  min-height: 100vh;
  background: rgba(0, 0, 0, 0.45);
}

.site-header {
  height: 100px;              /* lock the header height */
  padding: 0 40px;           /* remove vertical padding */
  display: flex;
  align-items: center;

  background-image: url("../images/header.png");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;

  border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  position: sticky;
  top: 0;
  z-index: 50;

  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

.header-inner {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between; /* ADD THIS */
}

.logo {
  font-size: 1.8rem;
  font-weight: bold;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.logo img {
  height: auto;
  max-height: 55px;
  width: auto;
  display: block;
}

.home .logo img,
.front-page .logo img {
  max-height: 90px;
}

.nav {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
}

.nav a {
  color: #fff;
  text-decoration: none;
  opacity: 0.9;
}

.nav a:hover {
  opacity: 0.6;
}

.hero {
  text-align: center;
  padding: 70px 20px 40px;
}

.hero h1 {
  font-size: clamp(2.5rem, 5vw, 5rem);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.hero p {
  max-width: 700px;
  margin: 15px auto 0;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.6;
}

.collections-section {
  max-width: 1400px;
  margin: 0 auto;
  padding: 40px 20px 100px;
}

.collections-stack {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
}

.collection-link {
  display: block;
  width: min(1400px, 95%);
  color: inherit;
  text-decoration: none;
}

.collection-link:hover,
.collection-link:focus,
.collection-link:active,
.collection-link:visited {
  color: inherit;
  text-decoration: none;
}

.collection-box {
  position: relative;
  width: 100%;
  height: 260px;
  border: 3px solid;
  border-radius: 30px;
  padding: 24px 24px 4px;
  background: transparent;
  overflow: hidden;
  display: flex;
  align-items: stretch;
  transition: transform 0.18s ease, background 0.18s ease;
  isolation: isolate;
}

.collection-link:hover .collection-box,
.collection-link:focus .collection-box {
  transform: translateY(-2px);
  background: rgba(0, 0, 0, 0.55);
}

.collection-bg {
  position: absolute;
  inset: -2px;
  border-radius: inherit;
  overflow: hidden;
  z-index: 0;
  pointer-events: none;
}

.collection-bg img {
  width: 100%;
  height: 100%;
  object-fit: fill;
  display: block;
  filter: brightness(0.75);
}

.collection-content {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: stretch;
}

.collection-label {
  position: absolute;
  top: 10px;
  left: 20px;
  padding: 6px 14px;
  border: 3px solid currentColor;
  border-radius: 999px;
  background: #000;
  font-weight: bold;
  text-transform: uppercase;
  font-size: 0.9rem;
  z-index: 4;
}

.carousel-shell {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: stretch;
}

.product-viewport {
  width: 100%;
  height: 100%;
  overflow: hidden;
  position: relative;
  border-radius: 22px;
  display: flex;
  justify-content: flex-start;
}

.product-track {
  display: flex;
  gap: 14px;
  transition: transform 0.5s ease;
  will-change: transform;
  align-items: stretch;
  height: 100%;
  width: 100%;
  justify-content: flex-start !important;
  margin-right: auto !important;
}

.product-card {
  flex: 0 0 calc((100% - 56px) / 5);
  width: calc((100% - 56px) / 5);
  min-width: calc((100% - 56px) / 5);
  height: 100%;
  border-radius: 22px;
  overflow: hidden;
  background: rgba(255,255,255,0.05);
  border: 6px solid #000;
  pointer-events: none;
}

.product-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  background: rgba(255,255,255,0.06);
}


.product-card--empty {
  justify-content: center;
}

.product-card--empty .product-meta {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.red {
  border-color: #ff4d4d;
  color: #ff4d4d;
}

.blue {
  border-color: #4da6ff;
  color: #4da6ff;
}

.green {
  border-color: #49d17d;
  color: #49d17d;
}

.yellow {
  border-color: #ffd84d;
  color: #ffd84d;
}

.site-footer {
  text-align: center;
  padding: 20px;
  background: rgba(0, 0, 0, 0.75);
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  font-size: 0.9rem;
  opacity: 0.8;
}

@media (max-width: 980px) {
  .product-card {
    flex: 0 0 calc((100% - 14px) / 2);
  }
}

@media (max-width: 640px) {
  .site-header {
    height: auto;          /* allow growth on mobile */
    padding: 12px 20px;
  }

  .header-inner {
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .logo img {
    max-height: 50px;
  }
}

